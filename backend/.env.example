# scan2order backend environment variables
# Copy to .env (at the repo root) and fill in values as needed.
# All variables are optional unless marked (required).

# ── Ollama LLM (OCR + ranking) ────────────────────────────────────────────────
# Injected by docker-compose as OLLAMA_HOST=http://ollama:11434 automatically.
# Only set these manually for local development outside Docker.
# OCR runs on Groq (cloud, fast, off-box) when GROQ_API_KEY is set, else on the
# local qwen2.5vl:3b. The local model also serves the ranking fallback.
# GROQ_API_KEY=gsk_...                                       # enables Groq OCR
# GROQ_OCR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:3b
# OCR_BACKEND=auto   # auto (Groq→local→Tesseract) | groq | ollama | tesseract
# OCR_MAX_DIM=900    # local-model image cap; lower = faster, raise if empty
#
# NOTE: the canonical env file is the repo-root .env.example — it also documents
# SECRET_KEY, Twilio (SMS OTP), and SMTP (email OTP). Use that one.

# ── Storage backend ──────────────────────────────────────────────────────────
# SQLite is the default; no config needed.
# To use MySQL / MariaDB, set MYSQL_URL and enable the mysql service in
# docker-compose.yml.
#
# MYSQL_URL=mysql://scan2order:changeme@mysql:3306/scan2order

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=8000
