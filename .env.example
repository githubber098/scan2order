# scan2order environment variables
# Copy this file to .env and fill in values as needed.
# All variables are optional unless marked (required).

# ── OCR: Groq cloud (recommended) ─────────────────────────────────────────────
# Set GROQ_API_KEY and OCR runs on Groq's LPUs — ~1-2s, off-box, so concurrent
# scans don't lag each other (free key at console.groq.com, no card). In the
# default OCR_BACKEND=auto, Groq is tried FIRST whenever this key is set, then it
# falls back to the local model, then Tesseract.
# GROQ_API_KEY=gsk_...
# GROQ_OCR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct   # default; vision-capable

# ── Ollama LLM (local OCR fallback + ranking) ─────────────────────────────────
# Used for the ranking fallback always, and for OCR when GROQ_API_KEY is unset.
# Default model: qwen2.5vl:3b  (~3GB, OCR-specialised). NOT auto-pulled:
#   docker compose exec ollama ollama pull qwen2.5vl:3b
# OLLAMA_MODEL=qwen2.5vl:3b
#
# OCR backend: auto (Groq→local→Tesseract) | groq | ollama | tesseract
# OCR_BACKEND=auto
#
# OCR image cap: lower = faster. qwen2.5vl reads handwriting at lower res than
# gemma4 did — try 900; raise toward 1200 if a scan comes back empty.
# OCR_MAX_DIM=900
#
# Optional: use a different model for OCR than for ranking (defaults to OLLAMA_MODEL)
# OCR_VISION_MODEL=qwen2.5vl:3b

# ── Storage backend ──────────────────────────────────────────────────────────
# Default: SQLite at data/sessions.db (no extra config needed).
# To switch to MySQL / MariaDB, set MYSQL_URL and uncomment the mysql
# service + MYSQL_URL line in docker-compose.yml.
#
# MYSQL_URL=mysql://scan2order:changeme@mysql:3306/scan2order
#
# Format:  mysql://USER:PASSWORD@HOST:PORT/DATABASE
# MariaDB is also supported:  mariadb://USER:PASSWORD@HOST:PORT/DATABASE

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production: a random hex string used to sign session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Without this, sessions are signed with a per-process random key and all
# users are logged out on every server restart.
# SECRET_KEY=your-64-char-hex-string-here

# ── SMS OTP (Twilio) ──────────────────────────────────────────────────────────
# Required for PHONE login in production.
# Sign up at console.twilio.com, get a phone number, then fill these in.
# Without them, OTP codes are printed to the server log (dev-only fallback).
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_FROM_NUMBER=+12015551234

# ── Email OTP (SMTP) ──────────────────────────────────────────────────────────
# Required for EMAIL login in production. Works with any SMTP provider.
# Without these set, OTP codes are printed to the server log (dev-only fallback).
# Port 587 = STARTTLS (default); port 465 = implicit SSL.
#
# PRODUCTION uses Resend (https://resend.com) with a verified sender domain —
# this is what scan2order.reysen.net runs, and what makes the code land in Gmail
# inboxes instead of spam. SMTP_USER is the literal string "resend"; SMTP_PASS is
# a Resend API key (re_...); SMTP_FROM must be on a domain verified in Resend.
#
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key
# SMTP_FROM=noreply@yourdomain.example
#
# Any other SMTP provider works too (Gmail app password, Fastmail, SES SMTP):
# SMTP_HOST=smtp.gmail.com / SMTP_USER=you@gmail.com / SMTP_PASS=app_password

# ── OTP dev mode ──────────────────────────────────────────────────────────────
# When set to 1, the OTP code is returned in the /api/auth/send-otp response and
# auto-filled in the UI. Use ONLY on test instances with no SMTP/SMS provider.
# NEVER set this in production — it would leak login codes to the API caller.
# OTP_DEV_MODE=1

# ── Guest browsing (Shop / Compare without login) ────────────────────────────
# Logged-out visitors can always browse the Shop and Compare tabs, but live
# prices require a store session. Set this to one of your OWN account's user_ids
# to let guests see live prices using that account's connected store sessions
# (READ-ONLY — guests can never add to a cart; that always requires login).
# Leave UNSET (default) to keep guest searches price-free until a visitor logs
# in and connects a store. Find your user_id in the app via /api/auth/me.
# GUEST_STORE_USER_ID=

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=8000
