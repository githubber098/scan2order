# scan2order backend environment variables
# Copy to .env (at the repo root) and fill in values as needed.
# All variables are optional unless marked (required).

# ── Ollama LLM ──────────────────────────────────────────────────────────────
# Injected by docker-compose as OLLAMA_HOST=http://ollama:11434 automatically.
# Only set these manually for local development outside Docker.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ── Storage backend ──────────────────────────────────────────────────────────
# SQLite is the default; no config needed.
# To use MySQL / MariaDB, set MYSQL_URL and enable the mysql service in
# docker-compose.yml.
#
# MYSQL_URL=mysql://scan2order:changeme@mysql:3306/scan2order

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=8000
